{
  "search": {
    "desc": "用户需要检索信息或文献，基于关键词或自然语言查询搜索引擎或本地文档；不涉及登录或与网页交互的 UI 操作，返回结构化搜索结果或链接。",
    "functions": [
      "agentdojo_slack__get_webpage",
      "agentdojo_slack__post_webpage"
    ]
  },
  "browser": {
    "desc": "需要通过自动化浏览器执行交互式任务，如登录、表单提交、点击页面元素、文件上传/下载或模拟用户在网页上的操作；适用于需要真实页面渲染与浏览器事件触发的场景。",
    "functions": [
      "browser",
      "playwright"
    ]
  },
  "email": {

{
  "scene": "process_control",
  "functions": {
    "exec": {
      "type": "function",
      "params": {
        "command": {
          "required": true,
          "desc": "完成用户任务所需的最小命令或控制指令。",
          "constraint_spec": {
            "mode": "static_or_dynamic_ai",
            "static": {
              "default": null,
              "allowed_values": [],
              "allowlist": [],
              "denylist": [
                "rm -rf /",
                "mkfs",
                "dd if="
              ],
              "regex": null,
              "min": null,
              "max": null
            },
            "dynamic_ai_hint": "只能生成查看、查询或控制当前任务相关进程的最小命令；停止或 kill 操作必须来自用户明确要求。命令必须最小化且可审计。优先生成只读命令；写入、删除、停止服务、安装依赖、提权、联网下载执行等动作必须由用户明确要求。不得串联危险命令，不得读取密钥、token、SSH 配置或系统敏感目录。"
          }
        }
      },
      "desc": "通过命令查看或控制本地/容器进程；适合 ps、pgrep、systemctl status 等进程诊断。"
    },
    "process": {
      "type": "function",
      "params": {
        "pid": {
          "required": true,
          "desc": "来自工具返回、日志或用户明确提供的进程 PID。",
          "constraint_spec": {
            "mode": "dynamic_ai",
            "static": {
              "default": null,
              "allowed_values": [],
              "allowlist": [],
              "denylist": [],
              "regex": "^[0-9]+$",
              "min": 1,
              "max": null
            },
            "dynamic_ai_hint": "只能使用上下文中可验证的 PID；不得猜测或影响系统级进程。PID 必须来自用户输入或工具返回，不能猜测。若用户只描述进程名称，应先使用查询动作获取 PID，而不是直接生成控制 PID。"
          }
        },
        "command": {
          "required": false,
          "desc": "完成用户任务所需的最小命令或控制指令。",
          "constraint_spec": {
            "mode": "dynamic_ai",
            "static": {
              "default": null,
              "allowed_values": [
                "status",
                "stop",
                "kill"
              ],
              "allowlist": [],
              "denylist": [],
              "regex": null,
              "min": null,
              "max": null
            },
            "dynamic_ai_hint": "仅允许针对当前任务相关进程的查看或停止操作；敏感操作需用户确认。命令必须最小化且可审计。优先生成只读命令；写入、删除、停止服务、安装依赖、提权、联网下载执行等动作必须由用户明确要求。不得串联危险命令，不得读取密钥、token、SSH 配置或系统敏感目录。"
          }
        }
      },
      "desc": "按 PID 或进程控制命令管理进程；适合查看状态或停止当前任务相关进程。"
    },
    "port_check__check": {
